<div id="app-container">
    <!-- Sidebar Navigation -->
    <div id="sidebar">
        <label id="logo">⚡ FlexUI Admin</label>
        
        <button id="nav-overview" class="nav-item" onclick="navOverview">📊 Overview</button>
        <button id="nav-customers" class="nav-item" onclick="navCustomers">👥 Customers</button>
        <button id="nav-products" class="nav-item" onclick="navProducts">📦 Products</button>
        <button id="nav-settings" class="nav-item" onclick="navSettings">⚙️ Settings</button>
    </div>
    
    <!-- Main Content -->
    <div id="main-content">
        <!-- Header -->
        <div id="header">
            <label id="page-title">Dashboard</label>
            <label id="page-subtitle">Welcome back! Here's what's happening.</label>
        </div>
        
        <!-- Stats Grid -->
        <div id="stats-grid">
            <div class="stat-card">
                <label class="stat-label">Total Revenue</label>
                <label id="stat-revenue-value" class="stat-value">$45,231.89</label>
                <label class="stat-change">+20.1% from last month</label>
            </div>
            
            <div class="stat-card">
                <label class="stat-label">Subscriptions</label>
                <label id="stat-subs-value" class="stat-value">+2350</label>
                <label class="stat-change">+180.1% from last month</label>
            </div>
            
            <div class="stat-card">
                <label class="stat-label">Sales</label>
                <label id="stat-sales-value" class="stat-value">+12,234</label>
                <label class="stat-change">+19% from last month</label>
            </div>
            
            <div class="stat-card">
                <label class="stat-label">Active Now</label>
                <label id="stat-active-value" class="stat-value">+573</label>
                <label class="stat-change">+201 since last hour</label>
            </div>
        </div>
        
        <!-- Dynamic Content Area -->
        <div id="content-grid">
            <div id="main-card" class="content-card">
                <label id="content-title" class="card-title">Overview</label>
                <label id="content-description" class="card-description">Monthly revenue and growth metrics</label>
                <label id="content-body" style="width: 480px; height: 280px; color: #64748b;">
                    📈 Loading...
                </label>
            </div>
            
            <div id="side-card" class="content-card">
                <label id="side-title" class="card-title">Recent Sales</label>
                <label id="side-description" class="card-description">You made 265 sales this month</label>
                <label id="recent-sales-list">Loading...</label>
            </div>
        </div>
        
        <!-- Action Bar -->
        <div id="action-bar">
            <button id="refresh-btn" onclick="refreshDashboard">🔄 Refresh</button>
            <label id="status-bar">Auto-updating every 3 seconds</label>
        </div>
    </div>
</div>
