<ui name="ChartFrame" xmlns:attr="urn:flexui:attribute" xmlns:var="urn:flexui:css-variable">
  <figure slot="chart" attr:role="figure" class="flex flex-col relative w-full box-border rounded-lg border bg-card text-card-foreground p-4 gap-4">
    <figcaption slot="chart-title" class="text-sm font-medium" var:overflow-wrap="anywhere" />
    <div slot="chart-surface" attr:role="img" class="relative w-full" />
    <div slot="chart-legend" attr:role="list" class="flex items-center justify-center gap-4 text-sm" />
    <div slot="chart-tooltip" attr:role="status" attr:data-state="inactive" attr:aria-hidden="true" class="absolute rounded-md border bg-popover text-popover-foreground p-2 shadow-md text-sm" utility="hidden" />
  </figure>
</ui>
