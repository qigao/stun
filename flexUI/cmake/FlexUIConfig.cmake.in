@PACKAGE_INIT@

set(FlexUI_Core_FOUND FALSE)
set(FlexUI_WidgetSDK_FOUND FALSE)
set(FlexUI_PluginSDK_FOUND FALSE)
set(FlexUI_Services_FOUND FALSE)
set(FlexUI_PluginHost_FOUND FALSE)
unset(FlexUI_NOT_FOUND_MESSAGE)

set(_FlexUI_supported_components Core WidgetSDK PluginSDK Services PluginHost)
set(_FlexUI_components "${FlexUI_FIND_COMPONENTS}")
if(NOT _FlexUI_components)
  set(_FlexUI_components PluginSDK Services)
  if(@FLEXUI_CONFIG_HAS_PLUGIN_HOST@)
    list(APPEND _FlexUI_components PluginHost)
  endif()
endif()

foreach(_FlexUI_component IN LISTS _FlexUI_components)
  if(NOT _FlexUI_component IN_LIST _FlexUI_supported_components)
    set(FlexUI_${_FlexUI_component}_FOUND FALSE)
    string(APPEND FlexUI_NOT_FOUND_MESSAGE
           "Unsupported FlexUI component: ${_FlexUI_component}. ")
  endif()
endforeach()

if("WidgetSDK" IN_LIST _FlexUI_components)
  list(APPEND _FlexUI_components Core)
endif()
list(REMOVE_DUPLICATES _FlexUI_components)

if("PluginHost" IN_LIST _FlexUI_components)
  if(@FLEXUI_CONFIG_HAS_PLUGIN_HOST@)
    list(APPEND _FlexUI_components PluginSDK Services)
  else()
    string(APPEND FlexUI_NOT_FOUND_MESSAGE
           "PluginHost was not enabled in this FlexUI installation. ")
  endif()
endif()

# Core is opt-in: finding PluginSDK alone must NOT require Flex, Lexbor,
# Salts, Markdown, GUI backends, or any runtime service dependencies.
if("Core" IN_LIST _FlexUI_components)
  include(CMakeFindDependencyMacro)
  find_dependency(Salts CONFIG)
  find_dependency(SaltsUtils CONFIG)
  find_dependency(Flex CONFIG)
  find_dependency(lexbor CONFIG)
  find_dependency(nlohmann_json CONFIG)
  find_dependency(pugixml CONFIG)
  find_dependency(unofficial-tree-sitter CONFIG)
  find_dependency(StunUICore CONFIG)
  include("${CMAKE_CURRENT_LIST_DIR}/FlexUICoreTargets.cmake")
  set(FlexUI_Core_FOUND TRUE)
  set(FlexUI_WidgetSDK_FOUND TRUE)
endif()

if("PluginSDK" IN_LIST _FlexUI_components)
  include("${CMAKE_CURRENT_LIST_DIR}/FlexUIPluginSDKTargets.cmake")
  set(FlexUI_PluginSDK_FOUND TRUE)
endif()
if("Services" IN_LIST _FlexUI_components)
  include("${CMAKE_CURRENT_LIST_DIR}/FlexUIServicesTargets.cmake")
  set(FlexUI_Services_FOUND TRUE)
endif()
if("PluginHost" IN_LIST _FlexUI_components AND @FLEXUI_CONFIG_HAS_PLUGIN_HOST@)
  include(CMakeFindDependencyMacro)
  find_dependency(Salts CONFIG)
  find_dependency(SaltsUtils CONFIG)
  include("${CMAKE_CURRENT_LIST_DIR}/FlexUIPluginHostTargets.cmake")
  set(FlexUI_PluginHost_FOUND TRUE)
endif()

check_required_components(FlexUI)
unset(_FlexUI_supported_components)
unset(_FlexUI_components)
unset(_FlexUI_component)
