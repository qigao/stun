  "cases": [
    {
      "name": "button-focus-visible-ring",
      "component": "button",
      "widget": "button",
      "tag": "button",
      "id": "field",
      "class_tokens": [
        "focus-visible:ring-2",
        "focus-visible:ring-ring",
        "focus-visible:ring-offset-2"
      ],
      "required_features": [
        "focus-visible",
        "outline",
        "ring",
        "ring-offset-color"
      ],
      "widget_props": {
        "text": "Save"
      },
      "states": [
        "focus",
        "focus-visible"
      ],
      "css": "#field { outline-width: 0px; outline-offset: 0px; ring-width: 0px; ring-offset: 0px; } #field:focus-visible { outline-width: 2px; outline-color: rgba(51, 102, 255, 0.5); outline-offset: 4px; ring-width: 6px; ring-color: rgba(8, 16, 24, 0.5); ring-offset: 2px; ring-offset-color: #f8fafc; }",
      "expect": {
        "computed": {
          "outline_width": 2.0,
          "outline_offset": 4.0,
          "ring_width": 6.0,
          "ring_offset": 2.0,
          "outline_color": [
            0.2,
            0.4,
            1.0,
            0.5
          ],
          "ring_color": [
            0.031373,
            0.062745,
            0.094118,
            0.5
          ],
          "ring_offset_color": [
            0.972549,
            0.980392,
            0.988235,
            1.0
          ]
        }
      }
    },
    {
      "name": "tailwind-escaped-focus-visible-class-selector",
      "component": "button",
      "widget": "button",
      "tag": "button",
      "id": "field",
      "class_tokens": [
        "focus-visible:ring-2"
      ],
      "required_features": [
        "tailwind-escaped-class-selector",
        "focus-visible",
        "ring"
