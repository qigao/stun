{
  "rules": [
    {
      "target": "input_root",
      "selector": "&",
      "decls": {
        "display": "flex",
        "width": "100%",
        "height": "2.25rem",
        "border-width": "1px",
        "border-style": "solid",
        "border-color": "var(--input)",
        "border-radius": "0.375rem",
        "background-color": "transparent",
        "padding-left": "0.75rem",
        "padding-right": "0.75rem",
        "padding-top": "0.25rem",
        "padding-bottom": "0.25rem",
        "font-size": "1rem",
        "box-shadow": "0 1px 2px rgba(0,0,0,0.08)",
        "caret-color": "var(--ring)"
      }
    },
    {
      "target": "input_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "size", "value": "sm" }
      ],
      "decls": {
        "height": "2rem",
        "font-size": "0.875rem"
      }
    },
    {
      "target": "input_root",
      "selector": "&::placeholder",
      "decls": {
        "color": "var(--muted-foreground)"
      }
    },
    {
      "target": "input_root",
      "selector": "&::selection",
      "decls": {
        "background-color": "var(--primary)",
        "color": "var(--primary-foreground)"
      }
    },
    {
      "target": "input_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "focus-visible" }
      ],
      "decls": {
        "outline-width": "0px",
        "ring-width": "1px",
        "ring-color": "var(--ring)"
      }
    },
    {
      "target": "input_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "disabled" }
      ],
      "decls": {
        "opacity": "0.5"
      }
    }
  ]
}
