{
  "rules": [
    {
      "target": "select_root",
      "selector": "&",
      "decls": {
        "display": "flex",
        "width": "100%",
        "height": "2.25rem",
        "align-items": "center",
        "justify-content": "space-between",
        "white-space": "nowrap",
        "border-width": "1px",
        "border-style": "solid",
        "border-color": "var(--input)",
        "border-radius": "0.375rem",
        "background-color": "transparent",
        "padding-left": "0.75rem",
        "padding-right": "0.75rem",
        "font-size": "0.875rem",
        "box-shadow": "0 1px 2px rgba(0,0,0,0.08)"
      }
    },
    {
      "target": "select_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "size", "value": "sm" }
      ],
      "decls": {
        "height": "2rem",
        "font-size": "0.75rem"
      }
    },
    {
      "target": "select_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "focus-visible" }
      ],
      "decls": {
        "outline-width": "0px",
        "ring-width": "1px",
        "ring-color": "var(--ring)"
      }
    },
    {
      "target": "select_root",
      "selector": "&[data-state=\"open\"]",
      "decls": {
        "background-color": "var(--accent)",
        "color": "var(--accent-foreground)"
      }
    },
    {
      "target": "select_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "disabled" }
      ],
      "decls": {
        "opacity": "0.5"
      }
    }
  ]
}
