{
  "rules": [
    {
      "target": "skeleton_root",
      "selector": "&",
      "decls": {
        "display": "block",
        "border-radius": "0.375rem",
        "background-color": "var(--accent)",
        "min-height": "1rem"
      }
    },
    {
      "target": "skeleton_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "loading" }
      ],
      "decls": {
        "animation": "shadcn-skeleton-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite"
      }
    }
  ],
  "keyframes": [
    {
      "name": "shadcn-skeleton-pulse",
      "steps": [
        {
          "offset": 0.0,
          "decls": {
            "opacity": "1"
          }
        },
        {
          "offset": 0.5,
          "decls": {
            "opacity": "0.5"
          }
        },
        {
          "offset": 1.0,
          "decls": {
            "opacity": "1"
          }
        }
      ]
    }
  ]
}
