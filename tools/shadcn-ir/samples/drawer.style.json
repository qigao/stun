{
  "rules": [
    {
      "target": "drawer_overlay",
      "selector": "&",
      "decls": {
        "position": "fixed",
        "left": "0px",
        "top": "0px",
        "right": "0px",
        "bottom": "0px",
        "z-index": "50",
        "background-color": "rgba(0, 0, 0, 0.8)"
      }
    },
    {
      "target": "drawer_content",
      "selector": "&",
      "decls": {
        "position": "fixed",
        "left": "0px",
        "right": "0px",
        "bottom": "0px",
        "z-index": "50",
        "margin-top": "6rem",
        "display": "flex",
        "height": "auto",
        "flex-direction": "column",
        "border-top-left-radius": "10px",
        "border-top-right-radius": "10px",
        "border-width": "1px",
        "border-style": "solid",
        "border-color": "var(--border)",
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      }
    },
    {
      "target": "drawer_content",
      "selector": "&",
      "when": [
        { "type": "attr", "name": "data-state", "equals": "closed" }
      ],
      "decls": {
        "display": "none"
      }
    },
    {
      "target": "drawer_handle",
      "selector": "&",
      "decls": {
        "margin-left": "auto",
        "margin-right": "auto",
        "margin-top": "1rem",
        "width": "100px",
        "height": "0.5rem",
        "border-radius": "9999px",
        "background-color": "var(--muted)"
      }
    },
    {
      "target": "drawer_header",
      "selector": "&",
      "decls": {
        "display": "grid",
        "gap": "0.375rem",
        "padding": "1rem",
        "text-align": "center"
      }
    },
    {
      "target": "drawer_footer",
      "selector": "&",
      "decls": {
        "margin-top": "auto",
        "display": "flex",
        "flex-direction": "column",
        "gap": "0.5rem",
        "padding": "1rem"
      }
    },
    {
      "target": "drawer_title",
      "selector": "&",
      "decls": {
        "font-size": "1.125rem",
        "font-weight": "600",
        "color": "var(--foreground)"
      }
    },
    {
      "target": "drawer_description",
      "selector": "&",
      "decls": {
        "font-size": "0.875rem",
        "color": "var(--muted-foreground)"
      }
    }
  ]
}
