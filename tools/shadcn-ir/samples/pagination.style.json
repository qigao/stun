{
  "rules": [
    {
      "target": "pagination_root",
      "selector": "&",
      "decls": {
        "margin-left": "auto",
        "margin-right": "auto",
        "display": "flex",
        "width": "100%",
        "justify-content": "center"
      }
    },
    {
      "target": "pagination_content",
      "selector": "&",
      "decls": {
        "display": "flex",
        "flex-direction": "row",
        "align-items": "center",
        "gap": "0.25rem"
      }
    },
    {
      "target": "pagination_previous",
      "selector": "&",
      "decls": {
        "display": "inline-flex",
        "height": "2.25rem",
        "align-items": "center",
        "justify-content": "center",
        "gap": "0.25rem",
        "border-radius": "0.375rem",
        "padding-left": "0.625rem",
        "padding-right": "0.625rem",
        "font-size": "0.875rem",
        "font-weight": "500",
        "color": "var(--foreground)",
        "transition": "background-color 150ms ease, color 150ms ease, opacity 150ms ease"
      }
    },
    {
      "target": "pagination_page_current",
      "selector": "&",
      "decls": {
        "display": "inline-flex",
        "height": "2.25rem",
        "min-width": "2.25rem",
        "align-items": "center",
        "justify-content": "center",
        "border-radius": "0.375rem",
        "border-width": "1px",
        "border-style": "solid",
        "border-color": "var(--border)",
        "font-size": "0.875rem",
        "font-weight": "500",
        "color": "var(--foreground)",
        "transition": "background-color 150ms ease, color 150ms ease, border-color 150ms ease"
      }
    },
    {
      "target": "pagination_next",
      "selector": "&",
      "decls": {
        "display": "inline-flex",
        "height": "2.25rem",
        "align-items": "center",
        "justify-content": "center",
        "gap": "0.25rem",
        "border-radius": "0.375rem",
        "padding-left": "0.625rem",
        "padding-right": "0.625rem",
        "font-size": "0.875rem",
        "font-weight": "500",
        "color": "var(--foreground)",
        "transition": "background-color 150ms ease, color 150ms ease, opacity 150ms ease"
      }
    },
    {
      "target": "pagination_page_current",
      "selector": "&",
      "when": [
        { "type": "state", "name": "current" }
      ],
      "decls": {
        "background-color": "var(--accent)",
        "color": "var(--accent-foreground)"
      }
    },
    {
      "target": "pagination_previous",
      "selector": "&",
      "when": [
        { "type": "state", "name": "disabled" }
      ],
      "decls": {
        "pointer-events": "none",
        "opacity": "0.5"
      }
    },
    {
      "target": "pagination_next",
      "selector": "&",
      "when": [
        { "type": "state", "name": "disabled" }
      ],
      "decls": {
        "pointer-events": "none",
        "opacity": "0.5"
      }
    }
  ]
}
