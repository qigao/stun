{
  "component": "Dialog",
  "kind": "composite",
  "root": "dialog_root",
  "nodes": [
    {
      "id": "dialog_root",
      "type": "widget",
      "widget": "dialog",
      "tag": "div",
      "role": "dialog",
      "slots": ["overlay", "content"],
      "states": ["open", "closed", "modal"],
      "attrs": {
        "aria-modal": true
      }
    },
    {
      "id": "overlay",
      "type": "element",
      "tag": "div",
      "slot": "overlay",
      "attrs": {
        "data-slot": "overlay"
      }
    },
    {
      "id": "content",
      "type": "element",
      "tag": "div",
      "slot": "content",
      "attrs": {
        "data-slot": "content"
      }
    },
    {
      "id": "header",
      "type": "element",
      "tag": "div",
      "slot": "header",
      "attrs": {
        "data-slot": "header"
      }
    },
    {
      "id": "title",
      "type": "element",
      "tag": "div",
      "slot": "title",
      "attrs": {
        "data-slot": "title"
      }
    },
    {
      "id": "description",
      "type": "element",
      "tag": "div",
      "slot": "description",
      "attrs": {
        "data-slot": "description"
      }
    },
    {
      "id": "footer",
      "type": "element",
      "tag": "div",
      "slot": "footer",
      "attrs": {
        "data-slot": "footer"
      }
    },
    {
      "id": "close",
      "type": "element",
      "tag": "button",
      "slot": "close",
      "role": "button",
      "states": ["hover", "focus", "disabled"],
      "attrs": {
        "data-slot": "close",
        "type": "button",
        "aria-label": "Close"
      }
    }
  ],
  "edges": [
    { "parent": "dialog_root", "child": "overlay" },
    { "parent": "dialog_root", "child": "content" },
    { "parent": "content", "child": "header" },
    { "parent": "header", "child": "title" },
    { "parent": "header", "child": "description" },
    { "parent": "content", "child": "footer" },
    { "parent": "content", "child": "close" }
  ],
  "variants": {
    "tone": ["default", "warning", "error"],
    "size": ["sm", "default", "lg"]
  },
  "defaults": {
    "tone": "default",
    "size": "default"
  },
  "overlay": {
    "portal": true,
    "modal": true
  },
  "meta": {
    "source": "shadcn/dialog"
  }
}
