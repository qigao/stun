{
  "rules": [
    {
      "target": "searchbox_root",
      "selector": "&",
      "decls": {
        "display": "flex",
        "width": "100%",
        "height": "2.25rem",
        "border-width": "1px",
        "border-style": "solid",
        "border-color": "var(--input)",
        "border-radius": "0.375rem",
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      }
    },
    {
      "target": "searchbox_root",
      "selector": "&",
      "when": [
        { "type": "attr", "name": "data-state", "equals": "open" }
      ],
      "decls": {
        "border-color": "var(--ring)",
        "ring-width": "1px",
        "ring-color": "var(--ring)"
      }
    }
  ]
}
