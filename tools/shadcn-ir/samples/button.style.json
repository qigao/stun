{
  "rules": [
    {
      "target": "button_root",
      "selector": "&",
      "decls": {
        "display": "inline-flex",
        "align-items": "center",
        "justify-content": "center",
        "gap": "0.5rem",
        "white-space": "nowrap",
        "border-radius": "0.375rem",
        "font-size": "0.875rem",
        "font-weight": "500",
        "transition": "background-color 150ms ease, color 150ms ease, border-color 150ms ease, opacity 150ms ease, ring-width 150ms ease, ring-color 150ms ease, ring-offset 150ms ease"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "variant", "value": "default" }
      ],
      "decls": {
        "background-color": "var(--primary)",
        "color": "var(--primary-foreground)",
        "box-shadow": "0 1px 2px rgba(0,0,0,0.12)"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "variant", "value": "destructive" }
      ],
      "decls": {
        "background-color": "var(--destructive)",
        "color": "var(--destructive-foreground)",
        "box-shadow": "0 1px 2px rgba(0,0,0,0.08)"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "variant", "value": "outline" }
      ],
      "decls": {
        "border-width": "1px",
        "border-style": "solid",
        "border-color": "var(--input)",
        "background-color": "var(--background)",
        "color": "var(--foreground)",
        "box-shadow": "0 1px 2px rgba(0,0,0,0.08)"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "variant", "value": "secondary" }
      ],
      "decls": {
        "background-color": "var(--secondary)",
        "color": "var(--secondary-foreground)",
        "box-shadow": "0 1px 2px rgba(0,0,0,0.08)"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "variant", "value": "ghost" }
      ],
      "decls": {
        "background-color": "transparent",
        "color": "var(--foreground)"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "variant", "value": "link" }
      ],
      "decls": {
        "background-color": "transparent",
        "color": "var(--primary)",
        "text-decoration-line": "none",
        "text-underline-offset": "4px"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "size", "value": "default" }
      ],
      "decls": {
        "height": "2.25rem",
        "padding-left": "1rem",
        "padding-right": "1rem",
        "padding-top": "0.5rem",
        "padding-bottom": "0.5rem"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "size", "value": "sm" }
      ],
      "decls": {
        "height": "2rem",
        "padding-left": "0.75rem",
        "padding-right": "0.75rem",
        "font-size": "0.75rem"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "size", "value": "lg" }
      ],
      "decls": {
        "height": "2.5rem",
        "padding-left": "2rem",
        "padding-right": "2rem"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "variant", "name": "size", "value": "icon" }
      ],
      "decls": {
        "width": "2.25rem",
        "height": "2.25rem",
        "padding": "0px"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "hover" },
        { "type": "variant", "name": "variant", "value": "default" }
      ],
      "decls": {
        "background-color": "color-mix(in oklab, var(--primary) 90%, transparent)"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "hover" },
        { "type": "variant", "name": "variant", "value": "outline" }
      ],
      "decls": {
        "background-color": "var(--accent)",
        "color": "var(--accent-foreground)"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "hover" },
        { "type": "variant", "name": "variant", "value": "ghost" }
      ],
      "decls": {
        "background-color": "var(--accent)",
        "color": "var(--accent-foreground)"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "hover" },
        { "type": "variant", "name": "variant", "value": "link" }
      ],
      "decls": {
        "text-decoration-line": "underline"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "focus-visible" }
      ],
      "decls": {
        "outline-width": "0px",
        "ring-width": "1px",
        "ring-color": "var(--ring)"
      }
    },
    {
      "target": "button_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "disabled" }
      ],
      "decls": {
        "opacity": "0.5"
      }
    }
  ]
}
