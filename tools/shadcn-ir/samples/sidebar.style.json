{
  "rules": [
    {
      "target": "sidebar_root",
      "selector": "&",
      "decls": {
        "display": "block",
        "width": "16rem",
        "background-color": "var(--sidebar)",
        "color": "var(--sidebar-foreground)"
      }
    },
    {
      "target": "sidebar_root",
      "selector": "&",
      "when": [
        { "type": "attr", "name": "data-state", "equals": "collapsed" }
      ],
      "decls": {
        "width": "3.5rem"
      }
    }
  ]
}
