{
  "rules": [
    {
      "target": "scroll_area_root",
      "selector": "&",
      "decls": {
        "position": "relative",
        "overflow": "hidden"
      }
    },
    {
      "target": "scroll_area_viewport",
      "selector": "&",
      "decls": {
        "width": "100%",
        "height": "100%",
        "overflow": "auto",
        "border-radius": "inherit"
      }
    },
    {
      "target": "scroll_area_scrollbar",
      "selector": "&",
      "decls": {
        "display": "flex",
        "touch-action": "none",
        "user-select": "none",
        "transition": "background-color 150ms ease"
      }
    },
    {
      "target": "scroll_area_scrollbar",
      "selector": "&",
      "when": [
        { "type": "attr", "name": "data-orientation", "equals": "vertical" }
      ],
      "decls": {
        "height": "100%",
        "width": "0.625rem",
        "border-left-width": "1px",
        "border-left-style": "solid",
        "border-left-color": "transparent",
        "padding": "1px"
      }
    },
    {
      "target": "scroll_area_thumb",
      "selector": "&",
      "decls": {
        "position": "relative",
        "flex": "1 1 0%",
        "border-radius": "9999px",
        "background-color": "var(--border)"
      }
    }
  ]
}
