{
  "rules": [
    {
      "target": "toggle_root",
      "selector": "&",
      "decls": {
        "display": "inline-flex",
        "align-items": "center",
        "justify-content": "center",
        "gap": "0.5rem",
        "border-radius": "0.375rem",
        "font-size": "0.875rem",
        "font-weight": "500",
        "height": "2.25rem",
        "padding-left": "0.75rem",
        "padding-right": "0.75rem",
        "transition": "background-color 150ms ease, color 150ms ease, opacity 150ms ease"
      }
    },
    {
      "target": "toggle_root",
      "selector": "&",
      "when": [
        { "type": "attr", "name": "data-state", "equals": "on" }
      ],
      "decls": {
        "background-color": "var(--accent)",
        "color": "var(--accent-foreground)"
      }
    },
    {
      "target": "toggle_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "hover" }
      ],
      "decls": {
        "background-color": "var(--muted)"
      }
    },
    {
      "target": "toggle_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "disabled" }
      ],
      "decls": {
        "opacity": "0.5"
      }
    }
  ]
}
