{
  "component": "HoverCard",
  "kind": "composite",
  "root": "hover_card_root",
  "nodes": [
    {
      "id": "hover_card_root",
      "type": "element",
      "tag": "div",
      "states": ["open", "closed"],
      "attrs": {
        "data-slot": "hover-card"
      }
    },
    {
      "id": "hover_card_trigger",
      "type": "element",
      "tag": "button",
      "slot": "trigger",
      "role": "button",
      "states": ["open", "closed", "focus-visible"],
      "attrs": {
        "data-slot": "hover-card-trigger",
        "type": "button",
        "aria-haspopup": "dialog",
        "aria-expanded": false
      },
      "props": {
        "text": "Hover"
      }
    },
    {
      "id": "hover_card_content",
      "type": "element",
      "tag": "div",
      "slot": "content",
      "role": "dialog",
      "states": ["open", "closed", "side-bottom"],
      "attrs": {
        "data-slot": "hover-card-content",
        "data-side": "bottom"
      },
      "props": {
        "text": "Hover card content"
      }
    }
  ],
  "edges": [
    { "parent": "hover_card_root", "child": "hover_card_trigger" },
    { "parent": "hover_card_root", "child": "hover_card_content" }
  ],
  "overlay": {
    "portal": true,
    "modal": false
  },
  "meta": {
    "source": "shadcn/hover-card"
  }
}
