{
  "rules": [
    {
      "target": "card_root",
      "selector": "&",
      "decls": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "1.5rem",
        "border-radius": "0.75rem",
        "border-width": "1px",
        "border-style": "solid",
        "border-color": "var(--border)",
        "background-color": "var(--card)",
        "color": "var(--card-foreground)",
        "padding": "1.5rem",
        "box-shadow": "0 1px 2px rgba(0,0,0,0.08)",
        "transition": "box-shadow 150ms ease, border-color 150ms ease"
      }
    },
    {
      "target": "card_header",
      "selector": "&",
      "decls": {
        "display": "grid",
        "gap": "0.375rem"
      }
    },
    {
      "target": "card_title",
      "selector": "&",
      "decls": {
        "font-size": "1.125rem",
        "font-weight": "600",
        "line-height": "1.25"
      }
    },
    {
      "target": "card_description",
      "selector": "&",
      "decls": {
        "color": "var(--muted-foreground)",
        "font-size": "0.875rem"
      }
    },
    {
      "target": "card_footer",
      "selector": "&",
      "decls": {
        "display": "flex",
        "align-items": "center",
        "gap": "0.5rem"
      }
    },
    {
      "target": "card_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "hover" }
      ],
      "decls": {
        "box-shadow": "0 2px 8px rgba(0,0,0,0.10)"
      }
    },
    {
      "target": "card_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "focus-visible" }
      ],
      "decls": {
        "outline-width": "0px",
        "ring-width": "1px",
        "ring-color": "var(--ring)"
      }
    }
  ]
}
