{
  "rules": [
    {
      "target": "tooltip_root",
      "selector": "&",
      "decls": {
        "background-color": "var(--popover)",
        "color": "var(--popover-foreground)",
        "border-radius": "0.375rem",
        "padding": "0.5rem"
      }
    },
    {
      "target": "tooltip_root",
      "selector": "&",
      "when": [
        { "type": "attr", "name": "data-state", "equals": "open" }
      ],
      "decls": {
        "opacity": "1"
      }
    },
    {
      "target": "tooltip_root",
      "selector": "&",
      "when": [
        { "type": "attr", "name": "data-side", "equals": "right" }
      ],
      "decls": {
        "text-align": "left"
      }
    }
  ]
}
