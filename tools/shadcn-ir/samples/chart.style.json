{
  "rules": [
    {
      "target": "chart_root",
      "selector": "&",
      "decls": {
        "display": "flex",
        "aspect-ratio": "16 / 9",
        "width": "100%",
        "justify-content": "center",
        "color": "var(--foreground)",
        "--color-desktop": "59, 130, 246, 255",
        "--color-mobile": "16, 185, 129, 255"
      }
    },
    {
      "target": "chart_root",
      "selector": "&",
      "when": [
        { "type": "state", "name": "theme-dark" }
      ],
      "decls": {
        "--color-desktop": "96, 165, 250, 255",
        "--color-mobile": "52, 211, 153, 255"
      }
    },
    {
      "target": "chart_surface",
      "selector": "&",
      "decls": {
        "width": "100%",
        "height": "100%",
        "outline": "none"
      }
    },
    {
      "target": "chart_tooltip",
      "selector": "&",
      "decls": {
        "display": "grid",
        "min-width": "8rem",
        "gap": "0.375rem",
        "padding": "0.375rem 0.625rem",
        "border-width": "1px",
        "border-style": "solid",
        "border-color": "var(--border)",
        "border-radius": "0.5rem",
        "background-color": "var(--background)",
        "box-shadow": "0 20px 25px -5px rgb(0 0 0 / 0.1)"
      }
    },
    {
      "target": "chart_tooltip",
      "selector": "&",
      "when": [
        { "type": "attr", "name": "data-state", "equals": "active" }
      ],
      "decls": {
        "opacity": "1"
      }
    },
    {
      "target": "chart_legend",
      "selector": "&",
      "decls": {
        "display": "flex",
        "align-items": "center",
        "justify-content": "center",
        "gap": "1rem",
        "padding-top": "0.75rem"
      }
    },
    {
      "target": "chart_legend_item",
      "selector": "&",
      "decls": {
        "display": "flex",
        "align-items": "center",
        "gap": "0.375rem",
        "color": "var(--muted-foreground)"
      }
    },
    {
      "target": "chart_legend_item",
      "selector": "&",
      "when": [
        { "type": "state", "name": "highlighted" }
      ],
      "decls": {
        "color": "var(--foreground)"
      }
    }
  ]
}
