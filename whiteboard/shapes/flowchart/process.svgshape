{
  "version": "1.0",
  "metadata": {
    "title": "Process",
    "category": "Flowchart",
    "description": "Flowchart process box with optional label"
  },
  "shapes": [
    {
      "type": "rect",
      "geometry": {
        "x": 0,
        "y": 0,
        "width": 120,
        "height": 60
      },
      "style": {
        "fill": "#3498db",
        "stroke": "#2c3e50",
        "stroke-width": "2"
      }
    },
    {
      "type": "text",
      "geometry": {
        "x": 60,
        "y": 30
      },
      "text": "{{label}}",
      "style": {
        "fill": "white",
        "font-size": "14px",
        "font-family": "Arial, sans-serif",
        "text-anchor": "middle",
        "dominant-baseline": "middle"
      }
    }
  ]
}
