{
  "version": "1.0",
  "metadata": {
    "title": "Comprehensive Shape Example",
    "category": "Examples",
    "description": "Shows all supported features: styles, lines, text, multiple shapes"
  },
  "shapes": [
    {
      "type": "rect",
      "geometry": {
        "x": 0,
        "y": 0,
        "width": 200,
        "height": 100,
        "rx": 10
      },
      "style": {
        "fill": "#3498db",
        "fill-opacity": "0.8",
        "stroke": "#2c3e50",
        "stroke-width": "3",
        "stroke-dasharray": "5,5",
        "stroke-linecap": "round"
      }
    },
    {
      "type": "path",
      "path_data": "M 20 80 L 180 80",
      "style": {
        "stroke": "#e74c3c",
        "stroke-width": "2",
        "fill": "none"
      }
    },
    {
      "type": "circle",
      "geometry": {
        "cx": 30,
        "cy": 30,
        "r": 15
      },
      "style": {
        "fill": "#2ecc71",
        "stroke": "#27ae60",
        "stroke-width": "2"
      }
    },
    {
      "type": "text",
      "geometry": {
        "x": 100,
        "y": 50
      },
      "text": "{{label}}",
      "style": {
        "fill": "white",
        "font-size": "16px",
        "font-family": "Arial, sans-serif",
        "font-weight": "bold",
        "text-anchor": "middle",
        "dominant-baseline": "middle"
      }
    },
    {
      "type": "text",
      "geometry": {
        "x": 100,
        "y": 90
      },
      "text": "{{subtitle}}",
      "style": {
        "fill": "#ecf0f1",
        "font-size": "12px",
        "font-family": "Arial, sans-serif",
        "text-anchor": "middle",
        "dominant-baseline": "middle"
      }
    }
  ]
}
