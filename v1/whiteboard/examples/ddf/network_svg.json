{
  "version": "1.0",
  "metadata": {
    "title": "Network Topology with SVG Shapes",
    "description": "Example using SVG shapes from the shape library",
    "author": "DDF Examples"
  },
  "shapes": [
    {
      "id": "router1",
      "type": "svg",
      "svg_shape_id": "network.router",
      "geometry": {
        "x": 300,
        "y": 50,
        "width": 80,
        "height": 80
      },
      "classes": ["network-device"],
      "text": "Core Router",
      "connection_points": [
        {"id": "bottom", "x_ratio": 0.5, "y_ratio": 1.0}
      ]
    },
    {
      "id": "server1",
      "type": "svg",
      "svg_shape_id": "network.server",
      "geometry": {
        "x": 150,
        "y": 200,
        "width": 80,
        "height": 80
      },
      "classes": ["network-device"],
      "text": "Web Server",
      "connection_points": [
        {"id": "top", "x_ratio": 0.5, "y_ratio": 0.0}
      ]
    },
    {
      "id": "server2",
      "type": "svg",
      "svg_shape_id": "network.server",
      "geometry": {
        "x": 450,
        "y": 200,
        "width": 80,
        "height": 80
      },
      "classes": ["network-device"],
      "text": "DB Server",
      "connection_points": [
        {"id": "top", "x_ratio": 0.5, "y_ratio": 0.0}
      ]
    },
    {
      "id": "firewall1",
      "type": "svg",
      "svg_shape_id": "network.firewall",
      "geometry": {
        "x": 300,
        "y": 350,
        "width": 80,
        "height": 80
      },
      "classes": ["network-device"],
      "text": "Firewall",
      "connection_points": [
        {"id": "top", "x_ratio": 0.5, "y_ratio": 0.0},
        {"id": "bottom", "x_ratio": 0.5, "y_ratio": 1.0}
      ]
    },
    {
      "id": "cloud1",
      "type": "svg",
      "svg_shape_id": "network.cloud_storage",
      "geometry": {
        "x": 300,
        "y": 500,
        "width": 100,
        "height": 60
      },
      "classes": ["network-device"],
      "text": "Internet",
      "connection_points": [
        {"id": "top", "x_ratio": 0.5, "y_ratio": 0.0}
      ]
    }
  ],
  "connectors": [
    {
      "id": "conn1",
      "from": {"shape_id": "router1", "connection_point": "bottom"},
      "to": {"shape_id": "server1", "connection_point": "top"},
      "style": {"stroke": "#3498db", "stroke-width": "2"},
      "arrow_end": "none"
    },
    {
      "id": "conn2",
      "from": {"shape_id": "router1", "connection_point": "bottom"},
      "to": {"shape_id": "server2", "connection_point": "top"},
      "style": {"stroke": "#3498db", "stroke-width": "2"},
      "arrow_end": "none"
    },
    {
      "id": "conn3",
      "from": {"shape_id": "server1", "connection_point": "top"},
      "to": {"shape_id": "firewall1", "connection_point": "top"},
      "style": {"stroke": "#e74c3c", "stroke-width": "2"},
      "arrow_end": "none"
    },
    {
      "id": "conn4",
      "from": {"shape_id": "firewall1", "connection_point": "bottom"},
      "to": {"shape_id": "cloud1", "connection_point": "top"},
      "style": {"stroke": "#2ecc71", "stroke-width": "3"},
      "arrow_end": "arrow"
    }
  ],
  "styles": {
    "rules": [
      {
        "selector": ".network-device",
        "properties": {
          "stroke": "#34495e",
          "stroke-width": "2",
          "fill": "#ecf0f1"
        }
      },
      {
        "selector": ".network-device:hover",
        "properties": {
          "fill": "#bdc3c7",
          "stroke-width": "3"
        }
      }
    ]
  }
}
