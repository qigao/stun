{
  "version": "1.0",
  "metadata": {
    "title": "Organization Chart Example",
    "description": "A simple organization chart demonstrating hierarchical data visualization",
    "author": "DDF Examples",
    "created": "2025-10-19T00:00:00Z"
  },
  "data": {
    "nodes": [
      {
        "id": "ceo",
        "type": "person",
        "properties": {
          "name": "Sarah Johnson",
          "title": "CEO",
          "department": "Executive",
          "email": "sarah.johnson@company.com"
        }
      },
      {
        "id": "cto",
        "type": "person",
        "properties": {
          "name": "Michael Chen",
          "title": "CTO",
          "department": "Technology",
          "email": "michael.chen@company.com"
        }
      },
      {
        "id": "cfo",
        "type": "person",
        "properties": {
          "name": "Emily Rodriguez",
          "title": "CFO",
          "department": "Finance",
          "email": "emily.rodriguez@company.com"
        }
      },
      {
        "id": "eng_manager",
        "type": "person",
        "properties": {
          "name": "David Kim",
          "title": "Engineering Manager",
          "department": "Technology",
          "email": "david.kim@company.com"
        }
      },
      {
        "id": "product_manager",
        "type": "person",
        "properties": {
          "name": "Lisa Wang",
          "title": "Product Manager",
          "department": "Technology",
          "email": "lisa.wang@company.com"
        }
      }
    ],
    "relationships": [
      {
        "id": "rel1",
        "type": "reports_to",
        "from": "cto",
        "to": "ceo"
      },
      {
        "id": "rel2",
        "type": "reports_to",
        "from": "cfo",
        "to": "ceo"
      },
      {
        "id": "rel3",
        "type": "reports_to",
        "from": "eng_manager",
        "to": "cto"
      },
      {
        "id": "rel4",
        "type": "reports_to",
        "from": "product_manager",
        "to": "cto"
      }
    ]
  },
  "styles": {
    "rules": [
      {
        "selector": ".person-card",
        "properties": {
          "fill": "#3498db",
          "stroke": "#2c3e50",
          "stroke-width": "2",
          "rx": "8",
          "ry": "8"
        }
      },
      {
        "selector": ".person-card:hover",
        "properties": {
          "fill": "#2980b9",
          "stroke": "#34495e",
          "stroke-width": "3"
        }
      },
      {
        "selector": ".person-card.selected",
        "properties": {
          "stroke": "#e74c3c",
          "stroke-width": "4"
        }
      },
      {
        "selector": ".person-name",
        "properties": {
          "fill": "#ffffff",
          "font-size": "14px",
          "font-weight": "bold",
          "text-anchor": "middle"
        }
      },
      {
        "selector": ".person-title",
        "properties": {
          "fill": "#ecf0f1",
          "font-size": "12px",
          "text-anchor": "middle"
        }
      }
    ]
  },
  "components": {
    "definitions": [
      {
        "id": "person_card",
        "name": "Person Card",
        "parameters": [
          {"name": "name", "type": "string", "default": ""},
          {"name": "title", "type": "string", "default": ""},
          {"name": "x", "type": "number", "default": "0"},
          {"name": "y", "type": "number", "default": "0"}
        ],
        "shapes": [
          {
            "type": "rect",
            "class": "person-card",
            "geometry": {
              "x": "{{x}}",
              "y": "{{y}}",
              "width": 160,
              "height": 80
            }
          },
          {
            "type": "text",
            "class": "person-name",
            "geometry": {
              "x": "{{x + 80}}",
              "y": "{{y + 30}}"
            },
            "text": "{{name}}"
          },
          {
            "type": "text",
            "class": "person-title",
            "geometry": {
              "x": "{{x + 80}}",
              "y": "{{y + 50}}"
            },
            "text": "{{title}}"
          }
        ],
        "connection_points": [
          {"id": "top", "x": 0.5, "y": 0},
          {"id": "bottom", "x": 0.5, "y": 1}
        ]
      }
    ]
  },
  "layouts": [
    {
      "id": "tree_layout",
      "algorithm": "tree",
      "parameters": {
        "direction": "top-down",
        "horizontal_spacing": 50,
        "vertical_spacing": 100,
        "root_node": "ceo"
      }
    }
  ],
  "events": [
    {
      "id": "hover_tooltip",
      "target": "*",
      "trigger": "hover",
      "actions": [
        {
          "type": "show_tooltip",
          "content": "{{data.name}} - {{data.email}}"
        }
      ]
    },
    {
      "id": "click_select",
      "target": "*",
      "trigger": "click",
      "actions": [
        {
          "type": "update_style",
          "property": "pseudo_state",
          "value": "selected"
        }
      ]
    }
  ]
}
