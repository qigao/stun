// Simplified advanced test - Step 1: Just add a text node
scene test {
    width: 800
    height: 600

    rect bg {
        x: 0
        y: 0
        width: 800
        height: 600
        fill: #1a1f29
    }

    text title {
        x: 400
        y: 100
        content: "Hello World"
        fontSize: 48
        color: white
    }
}
