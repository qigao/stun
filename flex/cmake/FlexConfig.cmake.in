@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Salts CONFIG REQUIRED)
find_dependency(SaltsUtils CONFIG REQUIRED)
find_dependency(box2d CONFIG REQUIRED)
find_dependency(Stb REQUIRED)
find_dependency(Threads REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/FlexTargets.cmake")
# stb is a header-only dependency in the installed geometry API.
set_property(TARGET Flex::Runtime APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES
             "${Stb_INCLUDE_DIR}")
set_property(TARGET Flex::Engine APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES
             "${Stb_INCLUDE_DIR}")

check_required_components(Flex)
